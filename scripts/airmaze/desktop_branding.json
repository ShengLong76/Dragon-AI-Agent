{
  "version": 10,
  "product": "Dragon AI Agent",
  "note": "User-visible product chrome only. Do not rename process names, Docker tags, tokens, ports, protocols, or license attribution.",
  "designSystem": {
    "skill": ".cursor/skills/ui-ux-pro-max",
    "master": "design-system/dragon-ai-agent/MASTER.md",
    "override": "design-system/dragon-ai-agent/pages/desktop-client.md",
    "note": "docs/airmaze/DESIGN.md",
    "style": "AI-Native UI",
    "why": "Open-source UI UX Pro Max generator. Catalog Inter / AI purple are not shipped; overlay uses Syne + existing dragon crimson on dark surfaces."
  },
  "font": {
    "family": "Syne",
    "license": "OFL-1.1",
    "pack": "branding/fonts/syne",
    "weight": 700,
    "why": "James picked Syne (OFL, variable, wordmark at ~700). Replaces upstream Collapse-Bold on .wordmark. Universal Sans / Gotham / Tesla faces are proprietary and are not shipped."
  },
  "tokens": {
    "primary": "#C41E3A",
    "background": "#1C1C20",
    "foreground": "#F0F0F5",
    "card": "#282830",
    "mutedForeground": "#C4C4CE",
    "ring": "#C41E3A",
    "fontSizeBody": "16px",
    "fontSizeUi": "14px",
    "lineHeightBody": "1.55"
  },
  "logo": {
    "svg": "branding/dragon-ai-agent-logo.svg",
    "png": "branding/dragon-ai-agent-logo.png",
    "png256": "branding/dragon-ai-agent-logo-256.png",
    "ico": "branding/dragon-ai-agent-logo.ico",
    "facing": "front",
    "body": "#314A73",
    "eyes": "#C41E3A",
    "why": "James's mark: front-facing navy low-poly dragon, coiled neck, horns the same navy, red eyes. No gold, no copper ring, not a side profile.",
    "boxed": false,
    "emptyStateSize": "22rem",
    "stack": "wordmark-in-front",
    "trayFit": "contain-max",
    "trayWhy": "Windows owns the tray/taskbar slot. Scale the dragon uniformly to the largest size that fits the cell (object-fit: contain). No crop, no stretch, no fixed pixel bump."
  },
  "voice": {
    "options": ["gpt", "grok"],
    "default": "gpt",
    "helper": "http://127.0.0.1:8654/api/voice",
    "why": "Add Grok full-duplex (wss://api.x.ai/v1/realtime?model=grok-voice-latest) beside existing GPT-Live. Overlay Talk with Grok hosts duplex. Do not replace GPT."
  },
  "sidebar": {
    "userFacingBots": ["Personal Assistant"],
    "hideDefaultHermes": true,
    "excludeHermes": true,
    "excludedProfileIds": ["default", "hermes"],
    "headerTitle": "Dragon AI",
    "headerAccessibleName": "Dragon AI Agent",
    "why": "Exclude the built-in default Hermes agent. Header lockup is Dragon AI + Teams Marketplace. Column hosts first; else body data-dragon-ai-sidebar-fixed in a clearance spacer above Sessions / Bots (do not cover those tabs). Sidebar and middle session names share 16px body. Personal Assistant stays."
  },
  "replacements": [
    {
      "from": "font-family: 'Collapse', var(--font-sans)",
      "to": "font-family: 'Syne', var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "font-family:'Collapse',var(--font-sans)",
      "to": "font-family:'Syne',var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "font-family:\"Collapse\",var(--font-sans)",
      "to": "font-family:\"Syne\",var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "font-family: Collapse, var(--font-sans)",
      "to": "font-family: \"Syne\", var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "font-family:Collapse,var(--font-sans)",
      "to": "font-family:\"Syne\",var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "'Collapse', var(--font-sans)",
      "to": "'Syne', var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "\"Collapse\", var(--font-sans)",
      "to": "\"Syne\", var(--font-sans)",
      "surface": "wordmark-font"
    },
    {
      "from": "HERMES AGENT",
      "to": "DRAGON AI AGENT",
      "surface": "empty-state-wordmark"
    },
    {
      "from": "Let's get you setup with Hermes Agent",
      "to": "Let's get you setup with Dragon AI Agent",
      "surface": "settings-onboarding"
    },
    {
      "from": "Setting up Hermes Agent",
      "to": "Setting up Dragon AI Agent",
      "surface": "settings-setup"
    },
    {
      "from": "Give Hermes a task",
      "to": "Give Dragon AI a task",
      "surface": "composer-placeholder"
    },
    {
      "from": "What should Hermes look at?",
      "to": "What should Dragon AI look at?",
      "surface": "empty-state-headline"
    },
    {
      "from": "About Hermes Desktop",
      "to": "About Dragon AI Agent",
      "surface": "settings-about"
    },
    {
      "from": "Configure Hermes desktop",
      "to": "Configure Dragon AI Agent",
      "surface": "settings-command-palette"
    },
    {
      "from": "Loading Hermes settings",
      "to": "Loading Dragon AI Agent settings",
      "surface": "settings-loading"
    },
    {
      "from": "Hermes Desktop is ready",
      "to": "Dragon AI Agent is ready",
      "surface": "settings-ready"
    },
    {
      "from": "Starting Hermes Desktop…",
      "to": "Starting Dragon AI Agent…",
      "surface": "settings-boot"
    },
    {
      "from": "Starting Hermes Desktop...",
      "to": "Starting Dragon AI Agent...",
      "surface": "settings-boot"
    },
    {
      "from": "Welcome to Hermes",
      "to": "Welcome to Dragon AI Agent",
      "surface": "settings-welcome"
    },
    {
      "from": "Uninstall Hermes",
      "to": "Uninstall Dragon AI Agent",
      "surface": "settings-uninstall"
    },
    {
      "from": "Hermes Agent",
      "to": "Dragon AI Agent",
      "surface": "product-name"
    },
    {
      "from": "Hermes (default)",
      "to": "Dragon AI (default)",
      "surface": "settings-default-profile"
    },
    {
      "from": "Reconnecting to Hermes…",
      "to": "Reconnecting to Dragon AI…",
      "surface": "composer-placeholder"
    },
    {
      "from": "Reconnecting to Hermes...",
      "to": "Reconnecting to Dragon AI...",
      "surface": "composer-placeholder"
    },
    {
      "from": "Starting Hermes...",
      "to": "Starting Dragon AI...",
      "surface": "composer-placeholder"
    },
    {
      "from": "Starting Hermes…",
      "to": "Starting Dragon AI…",
      "surface": "composer-placeholder"
    },
    {
      "from": "appName: 'Hermes'",
      "to": "appName: 'Dragon AI Agent'",
      "surface": "settings-app-name"
    },
    {
      "from": "appName: \"Hermes\"",
      "to": "appName: \"Dragon AI Agent\"",
      "surface": "settings-app-name"
    },
    {
      "from": "appName:\"Hermes\"",
      "to": "appName:\"Dragon AI Agent\"",
      "surface": "settings-app-name"
    },
    {
      "from": "return 'Hermes'",
      "to": "return ''",
      "surface": "sidebar-default-bot"
    },
    {
      "from": "return \"Hermes\"",
      "to": "return \"\"",
      "surface": "sidebar-default-bot"
    },
    {
      "from": "return\"Hermes\"",
      "to": "return\"\"",
      "surface": "sidebar-default-bot"
    }
  ],
  "source_only": [
    {
      "path_suffix": "plugins/hermes-bots/labels.ts",
      "from": "return 'Hermes'",
      "to": "return ''",
      "surface": "sidebar-default-bot"
    }
  ],
  "protected": [
    "X-Hermes-Session-Token",
    "127.0.0.1:8650",
    "dragon-local",
    "hermes-airmaze-gw",
    "hermes-airmaze-desktop",
    "nousresearch/hermes-agent",
    "HERMES_DASHBOARD_SESSION_TOKEN",
    "hermes://",
    "com.nousresearch.hermes"
  ]
}
